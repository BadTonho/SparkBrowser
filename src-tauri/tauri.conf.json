{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Veloce Browser",
  "version": "0.1.0",
  "identifier": "org.veloce.browser",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Veloce Browser",
        "width": 1280,
        "height": 820,
        "minWidth": 680,
        "minHeight": 480,
        "decorations": false,
        "transparent": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ]
  }
}

