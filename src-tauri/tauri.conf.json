{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Spark",
  "version": "0.1.2",
  "identifier": "org.spark.browser",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Spark",
        "width": 1280,
        "height": 820,
        "minWidth": 680,
        "minHeight": 480,
        "decorations": false,
        "transparent": true,
        "center": true,
        "browserExtensionsEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; media-src 'self' blob: data:; connect-src ipc: http://ipc.localhost; object-src 'none'; frame-src https://www.youtube-nocookie.com; base-uri 'self'; form-action 'none'",
      "devCsp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; media-src 'self' blob: data:; connect-src ipc: http://ipc.localhost http://localhost:1420 ws://localhost:1420; object-src 'none'; frame-src https://www.youtube-nocookie.com; base-uri 'self'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "recommends": [
          "libpulse0"
        ]
      },
      "rpm": {
        "recommends": [
          "pulseaudio-libs"
        ]
      }
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDJENzNCMDVGREZFNjVFQUYKUldTdlh1YmZYN0J6TGZDTEhsVXdLbTZNTkNvU012UmNVOEtJU1kzeE1xdjk3WW9QVlJzNFlTSUYK",
      "requireSignedVersion": true,
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
