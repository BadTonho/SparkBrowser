{
  "identifier": "org.spark.browser.native-tests",
  "productName": "Spark Native Tests",
  "app": {
    "security": {
      "capabilities": ["default", "native-test-dark-mode-probe", "native-test-minimum-font-probe"]
    },
    "windows": [{
      "label": "main",
      "title": "Spark Native Tests",
      "width": 1280,
      "height": 820,
      "minWidth": 680,
      "minHeight": 480,
      "decorations": false,
      "transparent": true,
      "center": true,
      "browserExtensionsEnabled": true
    }]
  },
  "bundle": { "active": false }
}
