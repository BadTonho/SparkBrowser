{
  "name": "navegador-opensource",
  "private": true,
  "license": "Apache-2.0",
  "version": "0.1.5",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "build:nebula": "node tools/build-nebula-background.mjs",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "validate": "node tools/testing/validate.mjs",
    "validate:quick": "node tools/testing/validate.mjs --quick",
    "tauri": "tauri",
    "test": "node --test tests/*.test.mjs",
    "test:native:build": "node tools/testing/build-native.mjs",
    "test:native:build:fast": "node tools/testing/build-native.mjs --fast",
    "test:native": "node tools/testing/native-smoke.mjs",
    "test:native:youtube": "node tools/testing/pip-youtube.mjs",
    "security:check": "node tools/security/check-repo.mjs",
    "release:setup-signing": "node tools/release/setup-signing.mjs",
    "release:version": "node tools/release/version.mjs",
    "release:build": "node tools/release/build.mjs",
    "release:manifest": "node tools/release/generate-manifest.mjs",
    "test:updater:build": "node tools/testing/build-update-fixtures.mjs",
    "test:native:auto-skip:youtube": "node tools/testing/auto-skip-youtube.mjs",
    "test:native:critical": "node tools/testing/native-smoke.mjs --suite critical",
    "architecture:check": "node tools/architecture/check.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.2.0",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "@tauri-apps/cli": "^2.2.0",
    "deepmerge": "file:tools/vendor/deepmerge",
    "svelte": "^5.16.0",
    "svelte-check": "^4.1.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.5"
  },
  "overrides": {
    "deepmerge": "file:tools/vendor/deepmerge"
  }
}
